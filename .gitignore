# ─── Legacy install trees (kept on disk for reference; too large for git) ───
# The archived VIT installations remain in the workspace so the AI assistant
# and developers can inspect raw JSPs, XML config, JAR manifests, etc., but
# they are NOT versioned. See .github/copilot-instructions.md and
# .github/skills/*/SKILL.md for the distilled facts we do version.
VIT_Vieweb/
VIT_Sigmalink/

# ─── Python (for extract_pdfs.py / extract_sigmalink_pdfs.py) ───
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ─── Node / front-end (future Nieweb work) ───
node_modules/
dist/
build/
.parcel-cache/
.next/
.nuxt/
.turbo/
.svelte-kit/

# ─── JVM / build outputs (future Nieweb work) ───
target/
*.class
*.jar
*.war
*.ear
.gradle/
!.gradle-wrapper.jar

# ─── IDE & OS noise ───
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs & scratch ───
*.log
*.tmp
*.bak
*.swp
*~

