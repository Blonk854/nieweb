{
  "AllowedHosts": "*",
  "Nieweb": {
    "Db": {
      "Provider": "Sqlite"
    },
    "Identity": {
      "Password": {
        "RequiredLength": 12,
        "RequireDigit": true,
        "RequireLowercase": true,
        "RequireUppercase": true,
        "RequireNonAlphanumeric": true,
        "RequiredUniqueChars": 4
      },
      "Lockout": {
        "AllowedForNewUsers": true,
        "MaxFailedAccessAttempts": 5,
        "DefaultLockoutTimeSpan": "00:15:00"
      },
      "User": {
        "RequireUniqueEmail": true
      },
      "Argon2id": {
        "MemoryKb": 65536,
        "Iterations": 3,
        "DegreeOfParallelism": 1,
        "SaltSize": 16,
        "HashSize": 32
      }
    },
    "Security": {
      "//RelaxedLogin": "When true, login security is relaxed: minimal password rules, no lockout, and forced password rotation is bypassed. Login always accepts an email OR a username. Set to false to restore hardened behaviour (the strict machinery is left fully in place).",
      "RelaxedLogin": true
    },
    "Auth": {
      "Jwt": {
        "Issuer": "https://nieweb.local",
        "Audience": "nieweb-api",
        "//SigningKey": "DEV ONLY - override in production via env var NIEWEB__AUTH__JWT__SIGNINGKEY or user-secrets. Minimum 32 UTF-8 bytes.",
        "SigningKey": "nieweb-dev-jwt-signing-key-DO-NOT-USE-IN-PROD",
        "//AccessTokenLifetime": "Absolute session length (no refresh/sliding window yet). Kept long so slow multi-source reports don't log the user out mid-wait.",
        "AccessTokenLifetime": "12:00:00",
        "ClockSkew": "00:00:30"
      },
      "Oidc": {
        "//": "OpenID Connect / Entra ID SSO. Disabled by default so Nieweb ships without an IdP. To enable: set Enabled=true, Authority (e.g. https://login.microsoftonline.com/<tenant-id>/v2.0), ClientId, and ClientSecret (via NIEWEB__AUTH__OIDC__CLIENTSECRET env var - never commit the secret).",
        "Enabled": false,
        "Authority": "",
        "ClientId": "",
        "ClientSecret": "",
        "Scopes": "openid profile email",
        "CallbackPath": "/signin-oidc",
        "SignedOutCallbackPath": "/signout-callback-oidc",
        "DefaultRole": "Reader",
        "ButtonLabel": "Single sign-on"
      }
    },
    "BoardSvgSync": {
      "//": "TC4 Phase B - Board-SVG asset pipeline. Coordinator polls every enabled BoardSvgSource row on IntervalSeconds and copies the newest matching {ProductName}.svg into CacheDirectory. Set Enabled=false to keep only the on-demand /api/admin/board-svgs/sync endpoint.",
      "CacheDirectory": "./data/board-svgs",
      "IntervalSeconds": 3600,
      "Enabled": true
    }
  },
  "ConnectionStrings": {
    "NiewebDb": "Data Source=nieweb-dev.db"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/nieweb-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "Nieweb.Api"
    }
  }
}
