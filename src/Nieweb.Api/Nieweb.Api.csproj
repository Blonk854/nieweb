<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
    <!--
      Nieweb.Web (React + Vite) sources live one folder over. Vite writes
      the built SPA into wwwroot/app/ via its own vite.config.ts. We keep
      that folder out of source control (see .gitignore) but include the
      built assets when they exist so `dotnet publish` sweeps them into
      the final output alongside the API.

      SpaRoot is relative to $(MSBuildProjectDirectory) and is used by
      the BuildNiewebSpa target below.
    -->
    <SpaRoot>..\Nieweb.Web\</SpaRoot>
    <SpaOutDir>$(MSBuildProjectDirectory)\wwwroot\app\</SpaOutDir>
    <!--
      Skip the SPA build in CI/local one-off compile if the SPA is not
      required (e.g. running only the API tests). Set to true to force
      a build even outside of Publish; set to false to skip it during
      Publish (developer machines without Node installed).
    -->
    <BuildNiewebSpaOnPublish Condition=" '$(BuildNiewebSpaOnPublish)' == '' ">true</BuildNiewebSpaOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nieweb.Data\Nieweb.Data.csproj" />
    <ProjectReference Include="..\Nieweb.Data.Migrations.Npgsql\Nieweb.Data.Migrations.Npgsql.csproj" />
    <ProjectReference Include="..\Nieweb.Data.Migrations.Sqlite\Nieweb.Data.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\Nieweb.Identity\Nieweb.Identity.csproj" />
    <ProjectReference Include="..\Nieweb.Reports\Nieweb.Reports.csproj" />
    <ProjectReference Include="..\Nieweb.DataSources.Sql\Nieweb.DataSources.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!--
      Design-time only: required by the dotnet-ef tool for the startup
      project. PrivateAssets=all keeps it out of the runtime dependency
      graph so it never ships to production.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

  <!--
    Publish-time build of the React SPA. On `dotnet publish`:
      1. Ensure npm is on PATH.
      2. Run `npm ci` for a reproducible install from package-lock.json.
      3. Run `npm run build` which type-checks and writes into
         $(SpaOutDir) = Nieweb.Api/wwwroot/app/.
      4. The standard Web SDK then sweeps wwwroot/** into the publish
         output alongside the compiled DLL.

    Guarded by BuildNiewebSpaOnPublish so developer machines without
    Node can skip the SPA build by setting the property to false, e.g.:
      dotnet publish -p:BuildNiewebSpaOnPublish=false
  -->
  <Target Name="BuildNiewebSpa" BeforeTargets="PrepareForPublish" Condition=" '$(BuildNiewebSpaOnPublish)' == 'true' ">
    <PropertyGroup>
      <_NpmCommand Condition=" '$(OS)' == 'Windows_NT' ">npm.cmd</_NpmCommand>
      <_NpmCommand Condition=" '$(OS)' != 'Windows_NT' ">npm</_NpmCommand>
    </PropertyGroup>
    <Message Text="Nieweb.Web: installing npm dependencies (npm ci) in $(SpaRoot)" Importance="high" />
    <Exec Command="$(_NpmCommand) ci" WorkingDirectory="$(SpaRoot)" />
    <Message Text="Nieweb.Web: building SPA bundle into $(SpaOutDir)" Importance="high" />
    <Exec Command="$(_NpmCommand) run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

</Project>

