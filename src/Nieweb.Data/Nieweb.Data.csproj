<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Nieweb.Data holds the DbContext + entity model and is deliberately
    provider-neutral. The Sqlite and Npgsql providers, plus their
    migrations and design-time factories, live in the sibling
    Nieweb.Data.Migrations.Sqlite and Nieweb.Data.Migrations.Npgsql
    projects. Nieweb.Api references both migrations projects and picks
    a provider at runtime from Nieweb:Db:Provider in configuration.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
  </ItemGroup>
</Project>
