<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      SignInManager and its DI extensions live in the shared framework
      assembly Microsoft.AspNetCore.Identity, not in the Identity.Core
      NuGet package. FrameworkReference gives this class library access
      to those types without turning it into an Sdk.Web project.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nieweb.Data\Nieweb.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Argon2id password hashing (RFC 9106). 1.3.1 is the current release
      by Keef Aragon; no known GHSA advisories at the time of pinning.
    -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />

    <!--
      Direct reference so this project owns the Identity dependency
      explicitly rather than picking it up transitively via Nieweb.Data.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
  </ItemGroup>

</Project>
