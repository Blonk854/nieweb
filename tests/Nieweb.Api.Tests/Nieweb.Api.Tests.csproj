<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      CA1707: xUnit method names use Method_Scenario_Expectation.
      CS1591: test methods do not require XML docs.
      xUnit1051: xUnit v3 nudges every async call to accept
                 TestContext.Current.CancellationToken. Useful in the
                 general case, but noisy for straight-line HTTP probes.
    -->
    <NoWarn>$(NoWarn);CA1707;CS1591;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nieweb.Api\Nieweb.Api.csproj" />
    <ProjectReference Include="..\..\src\Nieweb.Data\Nieweb.Data.csproj" />
    <ProjectReference Include="..\..\src\Nieweb.Data.Migrations.Sqlite\Nieweb.Data.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Nieweb.Identity\Nieweb.Identity.csproj" />
  </ItemGroup>

</Project>
