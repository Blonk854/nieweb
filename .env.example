# -----------------------------------------------------------------------------
# Nieweb - local environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` (git-ignored) and fill in real values.
# `.env` is loaded by tools/db/probe-schema.ps1 and probe-schema-extra.ps1
# (and future Nieweb dev scripts).
# NEVER commit `.env`. Never paste the real password into chat.
#
# Keys are prefixed by AOI source. Use the corresponding `-Prefix` argument
# to the probe scripts, e.g.:
#     tools/db/probe-schema.ps1 -Prefix AOI_POSTREFLOW_
#     tools/db/probe-schema.ps1 -Prefix AOI_PREREFLOW_
# -----------------------------------------------------------------------------

# --- Phase 1: post-reflow Mycronic AOI (HLYAOI2024 on HLYMSSQL2) ----------------
# Vision3D CR4 / CR5 schema (version 5.0). SQL Server authentication.
# LIVE production catalogue — actively receiving inspection rows.
# Read-only account `svc_hlyaoiprodinq` (provisioned 2026-07-29, replaced the
# old write-capable `svc_hlyaoiprod`). Code paths still stay read-only as
# defense-in-depth (enforced by src/Nieweb.DataSources.Sql/SqlGuards.cs).
# Was `HLYAOI` prior to 2026-07; same server.
AOI_POSTREFLOW_SERVER=HLYMSSQL2
AOI_POSTREFLOW_DATABASE=HLYAOI2024
AOI_POSTREFLOW_USER=
AOI_POSTREFLOW_PASSWORD=

# --- Phase 2: pre-reflow Mycronic AOI (older schema) --------------------------
# Older Vision3D revision. Read-only account provisioned by user.
# Fill in with the pre-reflow Superviseur server/db.
AOI_PREREFLOW_SERVER=
AOI_PREREFLOW_DATABASE=
AOI_PREREFLOW_USER=
AOI_PREREFLOW_PASSWORD=

# --- Shared connection tuning -------------------------------------------------
# Query timeout kept tight (matches AoiSourceOptions default) because we
# hit a live-and-inspecting SMT-line DB. Do not raise without a reason.
AOI_CONNECT_TIMEOUT=15
AOI_QUERY_TIMEOUT=30

# --- OpenID Connect / Entra ID SSO (optional; dormant by default) -------------
# Nieweb ships with OIDC disabled. Set NIEWEB__AUTH__OIDC__ENABLED=true
# and supply Authority + ClientId + ClientSecret to enable it. When
# enabled, first-time SSO sign-ins are auto-provisioned in the Nieweb
# internal DB as `Reader`; local accounts with the same email are
# refused (anti-hijack). Full configuration reference: docs/deploy.md §11.
#
# NIEWEB__AUTH__OIDC__ENABLED=true
# NIEWEB__AUTH__OIDC__AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
# NIEWEB__AUTH__OIDC__CLIENTID=<application-id>
# NIEWEB__AUTH__OIDC__CLIENTSECRET=<client-secret-value>
# NIEWEB__AUTH__OIDC__BUTTONLABEL=Contoso SSO
