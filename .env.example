# -----------------------------------------------------------------------------
# Nieweb — local environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` (git-ignored) and fill in real values.
# `.env` is loaded by tools/db/probe-schema.ps1 (and future dev scripts).
# NEVER commit `.env`. Never paste the real password into chat.
# -----------------------------------------------------------------------------

# --- Archived AOI dev database (HLYAOI on HLYMSSQL2) ---------------------------
# SQL Server authentication (Windows auth is not available for this account).
# The account currently has WRITE access, so all code paths must stay read-only.
AOI_SERVER=HLYMSSQL2
AOI_DATABASE=HLYAOI
AOI_USER=
AOI_PASSWORD=

# Optional: extra connection tuning
AOI_CONNECT_TIMEOUT=15
AOI_QUERY_TIMEOUT=60
